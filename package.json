{
  "name": "pillcount",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "repository": { "type": "git", "url": "git+https://github.com/freeappstore-online/pillcount.git" },
  "scripts": {
    "dev": "pnpm --filter @pillcount/web dev",
    "build": "pnpm --filter @pillcount/web build",
    "preview": "pnpm --filter @pillcount/web preview",
    "typecheck": "pnpm --filter @pillcount/web exec tsc -b",
    "test": "pnpm --filter @pillcount/web exec tsc -b"
  }
}
